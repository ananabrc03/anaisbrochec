---
import {route,texts,type Lang} from '../lib/content';
import '../styles/global.css';
const {lang='fr',page='home',title,description,projectId,noindex=false,og} = Astro.props as {lang:Lang,page:string,title?:string,description?:string,projectId?:string,noindex?:boolean,og?:string};
const t=texts(lang),other=lang==='fr'?'en':'fr'; const site=import.meta.env.PUBLIC_SITE_URL||'http://localhost:4321';
const canonical=new URL(Astro.url.pathname,site).href; const alternate=route(other,page,projectId);
const image=new URL(og||`/brand/og-image-${lang}.jpg`,site).href;
---
<!doctype html><html lang={lang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title||t.home.title} · Anaïs Brochec</title><meta name="description" content={description||t.meta.default_description}/><link rel="canonical" href={canonical}/><link rel="alternate" hreflang={lang} href={canonical}/><link rel="alternate" hreflang={other} href={new URL(alternate,site).href}/><link rel="alternate" hreflang="x-default" href={new URL(route('fr',page,projectId),site).href}/>{noindex&&<meta name="robots" content="noindex,nofollow"/>}<meta property="og:title" content={title||t.meta.site_name}/><meta property="og:description" content={description||t.meta.default_description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta property="og:image" content={image}/><meta name="twitter:card" content="summary_large_image"/><meta name="theme-color" content="#702D42"/><link rel="icon" type="image/svg+xml" href="/brand/favicon.svg"/><link rel="icon" href="/brand/favicon.ico"/><link rel="apple-touch-icon" href="/brand/apple-touch-icon.png"/><link rel="manifest" href="/site.webmanifest"/><link rel="preload" href="/fonts/bricolage-grotesque-var.woff2" as="font" type="font/woff2" crossorigin/><link rel="preload" href="/fonts/manrope-var.woff2" as="font" type="font/woff2" crossorigin/>{page==='home'&&<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Person',name:'Anaïs Brochec',url:site,jobTitle:'Marketing digital, stratégie & innovation',sameAs:[t.coordonnees.linkedin],alumniOf:['Université Paris Dauphine-PSL','Université de Montpellier'],address:{'@type':'PostalAddress',addressLocality:'Paris',addressCountry:'FR'}})}/>}</head>
<body data-lang={lang} data-supabase-url={import.meta.env.PUBLIC_SUPABASE_URL} data-supabase-key={import.meta.env.PUBLIC_SUPABASE_ANON_KEY}>
<a class="skip" href="#main">{t.nav.skip}</a>
<header class="header"><div class="nav-shell"><a class="brand" href={route(lang)}><img src="/media/photos/anais-portrait-carre-400.webp" alt="Anaïs Brochec — accueil" width="38" height="38"/></a><nav class="desktop-nav" aria-label={t.nav.menu_open}>{(['home','about','projects','cv'] as const).map(p=><a class:list={{active:page===p}} aria-current={page===p?'page':undefined} href={route(lang,p)}>{t.nav[p]}</a>)}</nav><div class="nav-right"><a class="language" href={alternate} data-language-switch aria-label={lang==='fr'?'Passer en anglais':'Switch to French'}>{lang.toUpperCase()}</a><a class="button primary nav-contact" href={route(lang,'contact')}>{t.nav.contact} <span>↗</span></a><button class="burger" aria-label={t.nav.menu_open}>☰</button></div></div></header>
<dialog id="mobile-menu"><button class="menu-close" aria-label={t.common.close}>×</button><nav>{(['home','about','projects','cv','contact'] as const).map(p=><a class:list={{active:page===p}} aria-current={page===p?'page':undefined} href={route(lang,p)}>{t.nav[p]}</a>)}</nav></dialog>
<main id="main"><slot/></main>
<footer><div class="shell footer-grid"><div><img src="/brand/logo-ab-creme.svg" alt="Anaïs Brochec" width="58" height="58"/><p>{t.footer.tagline}</p></div><div><a href={'mailto:'+t.coordonnees.email}>{t.coordonnees.email} ↗</a><a href={t.coordonnees.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href={route(lang,'cv')}>{t.common.download_cv}</a></div><div><a href={route(lang,'legal')}>{t.footer.legal}</a><a href={route(lang,'privacy')}>{t.footer.privacy}</a></div></div><div class="shell footer-bottom">{t.footer.rights}</div></footer>
<script>import '../scripts/public';</script>
</body></html>
