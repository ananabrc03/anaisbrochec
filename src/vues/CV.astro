---
import {texts,type Lang} from '../lib/content';
const {lang}=Astro.props as {lang:Lang};
const t=texts(lang);
---
<section class="section shell cv-page">
<p class="eyebrow">{t.nav.cv}</p>
<h1>{t.cv.title}<span class="coral">.</span>
</h1>
<p class="lead">{t.cv.intro}</p>
<h2 class="step-title">{t.cv.choose}</h2>
<div class="cv-grid" role="radiogroup" aria-label={t.cv.choose}>{t.cv.domains.map((d,i)=><button class="cv-option" role="radio" aria-checked="false" data-cv-domain={d.id}>
<span class="eyebrow">0{i+1}<span class="option-circle" aria-hidden="true">○</span>
</span>
<h3>{d.titre}</h3>
</button>)}</div>

<div class="cv-downloads" hidden>
<h2>{t.cv.download_step}</h2>
<div class="actions">
<a class="button primary" data-cv-lang="fr" download>{t.cv.btn_fr}<span>↓</span>
</a>
<a class="button secondary" data-cv-lang="en" download>{t.cv.btn_en} ↓</a>
</div>

</div>

</section>

