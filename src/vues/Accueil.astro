---
import {texts,projects,route,graph,label,tools,type Lang} from '../lib/content';
import ProjectCard from '../components/ProjectCard.astro';
const {lang}=Astro.props as {lang:Lang};
const t=texts(lang),all=projects(lang);
const skillChips=graph.familles.flatMap(f=>f.sous_competences).slice(0,24).map(c=>({name:label(c,'nom',lang),href:route(lang,'about')+'#'+c.id,kind:'skill'}));
const qualityChips=Array.from({length:10},(_,i)=>graph.qualites[i%graph.qualites.length]).map(c=>({name:label(c,'nom',lang),href:route(lang,'about')+'#'+c.id,kind:'quality'}));
const toolChips=['canva','excel','shopify','claude-code','davinci-resolve','notion'].map(id=>tools.outils.find(t=>t.id===id)!).map(t=>({name:t.nom,href:route(lang,'about')+'#outil-'+t.id,kind:'tool-chip'}));
// Each cycle contains 24 skills, 6 tools and 10 qualities (60 / 15 / 25%).
const chips:{name:string;href:string;kind:string}[]=[];
for(let i=0;i<40;i++){if([3,9,16,23,29,36].includes(i))chips.push(toolChips.shift()!);else if([2,6,10,14,18,22,26,30,34,38].includes(i))chips.push(qualityChips.shift()!);else chips.push(skillChips.shift()!);}
---

<section class="hero shell">
<div class="hero-copy">
<h1>Anaïs<br/>
<em>Brochec<span class="coral">.</span>
</em>
</h1>
<h2 class="tagline">{t.home.tagline}</h2>
<p class="hero-intro">{t.home.intro}</p>
<div class="actions">
<a class="button primary" href={route(lang,'projects')}>{t.home.cta_primary}<span>↗</span>
</a>
<a class="text-link" href={route(lang,'cv')}>{t.common.download_cv} ↓</a>
</div>

</div>

<div class="portrait-stage">
<div class="orbit one"/>
<div class="orbit two"/>
<picture>
<source type="image/avif" srcset="/media/photos/anais-portrait-carre-400.avif 400w, /media/photos/anais-portrait-carre-640.avif 640w, /media/photos/anais-portrait-carre-820.avif 820w" sizes="(max-width:640px) 220px,(max-width:1024px) 320px,420px"/>
<source type="image/webp" srcset="/media/photos/anais-portrait-carre-400.webp 400w, /media/photos/anais-portrait-carre-640.webp 640w, /media/photos/anais-portrait-carre-820.webp 820w" sizes="(max-width:640px) 220px,(max-width:1024px) 320px,420px"/>
<img class="hero-photo" src="/media/photos/anais-portrait-carre-640.jpg" width="420" height="420" alt="Anaïs Brochec" fetchpriority="high" loading="eager"/>
</picture>{t.home.bubbles.map((b,i)=><span class={'floating badge-'+i}>{i===0?'✦':i===1?'↗':'◉'} {b}</span>)}<span class="stage-star" aria-hidden="true">✳</span>
</div>

</section>

<div class="ribbon">
<div class="ribbon-track">{[0,1].map(copy=><div class="ribbon-group" aria-hidden={copy===1?'true':undefined}>{graph.familles.map(f=><span>{label(f,'nom',lang)} <b aria-hidden="true">✦</b>
</span>)}</div>
)}</div>

</div>

<section class="section shell">
<div class="section-heading">
<div>
<h2>{t.home.projects_title}</h2>
</div>

</div>

<div class="project-grid">{t.home.featured_projects.map(id=><ProjectCard lang={lang} project={all.find(p=>p.id===id)}/>)}<a class="all-projects" href={route(lang,'projects')}>
<span aria-hidden="true">↗</span>
<h3>{t.common.see_all}</h3>
<p>{all.length} · {t.projects.title}</p>
</a>
</div>

</section>

<section class="about-band">
<div class="shell about-band-grid">
<div>
<h2>{t.home.about_title}</h2>
<p class="lead">{t.home.about_text}</p>
<div class="actions">
<a class="button primary" href={route(lang,'about')}>{t.home.about_cta}<span>↗</span>
</a>
</div>

</div>

<div class="stats-stack">{t.stats.map(s=><div>
<strong>{s.valeur}</strong>
<span>{s.libelle}</span>
</div>
)}</div>

</div>

</section>

<section class="section skills-marquee">
<div class="shell">
<h2>{t.home.skills_title}</h2>
</div>
{[0,1,2].map(row=><div class="marquee">
<div>{[0,1].map(copy=><span aria-hidden={copy===1?'true':undefined}>{chips.filter((_,i)=>i%3===row).map(c=><a class:list={['chip',c.kind]} href={c.href} tabindex={copy===1?-1:0}>{c.name}</a>)}</span>)}</div>

</div>
)}<div class="marquee-cta">
<a class="button primary" href={route(lang,'about')+'#competences'}>{t.home.skills_cta}<span>↗</span>
</a>
</div>

</section>


