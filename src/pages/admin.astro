---
import Base from '../layouts/Base.astro';
---
<Base lang="fr" page="admin" title="Espace admin" noindex={true}><section class="shell section admin-page" data-admin-email={import.meta.env.PUBLIC_ADMIN_EMAIL||'anaisbrochec@yahoo.fr'}><form class="admin-login form-card"><img src="/brand/logo-ab.svg" alt="" width="60" height="60"/><h1>Espace admin</h1><label>Mot de passe<input type="password" name="password" required autocomplete="current-password"/></label><p role="status" class="admin-error"/><button class="button primary">Se connecter <span>↗</span></button></form><div class="dashboard" hidden><div class="section-heading"><h1>Tableau de bord</h1><button class="chip logout">Se déconnecter</button></div><div class="segmented" role="tablist"><button role="tab" aria-selected="true" aria-controls="messages-tab" id="messages-trigger" data-admin-tab="messages">Messages <span class="new-count"/></button><button role="tab" aria-selected="false" aria-controls="stats-tab" id="stats-trigger" data-admin-tab="stats">Statistiques</button></div><p class="dashboard-status" role="status"/><section id="messages-tab" role="tabpanel" aria-labelledby="messages-trigger"><div class="admin-filters"><label>Statut<select class="status-filter"><option value="">Tous</option><option value="nouveau">Nouveau</option><option value="lu">Lu</option><option value="traite">Traité</option><option value="archive">Archivé</option></select></label><label>Type<select class="type-filter"><option value="">Tous</option><option value="emploi">Emploi</option><option value="stage">Stage</option><option value="conseil">Conseil</option><option value="web">Web</option><option value="autre">Autre</option></select></label><label>Rechercher<input class="search-filter" type="search"/></label><button class="chip refresh">Actualiser</button></div><div class="message-list"/></section><section id="stats-tab" role="tabpanel" aria-labelledby="stats-trigger" hidden><div class="kpi-grid stats-cards"/><h2>Visites · 30 derniers jours</h2><div class="chart"/><div class="stats-tables"/></section></div></section><dialog class="message-dialog"><button class="message-close chip">Fermer ×</button><h2 class="detail-name"/><div class="detail-meta"/><p class="detail-message"/><a class="button primary reply" href="#">Répondre ↗</a><div class="attachment" hidden><h3>Pièce jointe</h3><iframe title="Aperçu PDF" sandbox="allow-same-origin"/><a class="attachment-download text-link" target="_blank" rel="noopener noreferrer">Télécharger ↗</a></div><label>Statut<select class="detail-status"><option value="nouveau">Nouveau</option><option value="lu">Lu</option><option value="traite">Traité</option><option value="archive">Archivé</option></select></label><label>Note interne<textarea class="detail-note" rows="4"/></label><p class="note-state" role="status"/><button class="chip delete-message">Supprimer le message</button></dialog><dialog class="delete-dialog"><h2>Supprimer ce message ?</h2><p>Le message et sa pièce jointe seront supprimés définitivement.</p><div class="actions"><button class="button secondary delete-cancel">Annuler</button><button class="button primary delete-confirm">Supprimer</button></div></dialog></Base>
<style>.admin-login{max-width:440px;margin:20px auto}.admin-login img{margin-bottom:25px}.admin-login h1{font-size:2.3rem}.admin-page{min-height:65vh}.admin-error,.dashboard-status{color:#9a3f35}.admin-filters{display:flex;gap:20px;align-items:center;flex-wrap:wrap}.admin-filters label{flex:1;min-width:150px}.message-row{width:100%;display:grid;grid-template-columns:1fr 1.5fr 1fr 1fr;gap:20px;background:#fffcf8;border:1px solid var(--line);border-radius:14px;margin-bottom:10px;padding:20px;text-align:left;font-size:.84rem}.message-dialog{width:min(760px,95vw);max-height:90vh;background:var(--cream);color:var(--ink);border:1px solid var(--line);border-radius:24px;padding:35px}.message-close{float:right;margin-bottom:20px}.detail-name{clear:both}.detail-message{white-space:pre-wrap;overflow-wrap:anywhere;margin:30px 0}.detail-meta{font-size:.87rem}.attachment iframe{width:100%;height:420px;border:1px solid var(--line);border-radius:15px;margin:20px 0}.attachment{margin:35px 0}.detail-status{max-width:250px}.delete-message{background:#f7e0dc;color:#9a3f35}.delete-dialog{background:var(--cream);border:1px solid var(--line);border-radius:22px;padding:35px;max-width:90vw}.stats-cards{margin:25px 0 45px}.chart{overflow:auto;margin-bottom:40px}.chart svg{width:100%;min-width:640px}.stats-tables{display:grid;grid-template-columns:1fr 1fr;gap:30px}.stats-tables>div{background:white;padding:25px;border-radius:20px;border:1px solid var(--line)}.new-count{background:var(--coral);border-radius:99px;padding:3px 7px;margin-left:5px;font-size:.75rem}.admin-page [role=tab][aria-selected=true]{background:var(--vin);color:var(--cream)}.detail-meta p{margin-bottom:8px}@media(max-width:639px){.admin-filters{gap:10px}.admin-filters label{min-width:100%;margin-bottom:5px}.message-row{grid-template-columns:1fr 1fr;gap:10px}.stats-tables{grid-template-columns:1fr}.message-dialog{padding:22px}.admin-page .section-heading h1{font-size:2.5rem}}</style>
<script>import '../scripts/admin';</script>
