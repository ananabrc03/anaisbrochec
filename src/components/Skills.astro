---
import {graph,label,route,texts,type Lang} from '../lib/content';
const {lang} = Astro.props as {lang:Lang}; const t=texts(lang);
---
<section class="section shell" id="competences"><h2>{t.about.skills_title}</h2><p class="lead">{t.about.skills_intro}</p><div class="segmented" role="radiogroup" aria-label={t.about.mode_switch_label}><button role="radio" aria-checked="true" data-mode="skills">{t.about.mode_skills}</button><button role="radio" aria-checked="false" data-mode="qualities">{t.about.mode_qualities}</button></div>
<div class="skills-stage">
{[...graph.familles.map((f:any)=>({...f,mode:'skills'})),...graph.qualites.map((q:any)=>({...q,mode:'qualities'}))].map((item:any)=><details class="skill-detail" id={item.id} data-skill-mode={item.mode} name="skills" hidden={item.mode==='qualities'}><summary class:list={{quality:item.mode==='qualities'}}>{label(item,'nom',lang)}<span aria-hidden="true">↘</span></summary><div class="skill-panel"><h3>{label(item,'nom',lang)}</h3><p>{label(item,item.mode==='skills'?'description':'accroche',lang)}</p>{item.sous_competences?.map((s:any)=><div id={s.id}><h4>{label(s,'nom',lang)}</h4>{s.preuves.map((p:any)=><p>{label(p,'texte',lang)} <a href={route(lang,'projects',p.projet)+'#mission-'+(p.missions?.[0]||1)}>{t.common.see_project} ↗</a></p>)}{label(s,'complements_parcours',lang)?.map((p:string)=><p>{p} <a href="#parcours">{t.about.from_timeline}</a></p>)}</div>)}{item.exemples?.map((e:any)=><p>{label(e,'texte',lang)} <a href={e.ref==='parcours'?'#parcours':route(lang,'projects',e.ref)}>{e.ref==='parcours'?t.about.from_timeline:t.common.see_project} ↗</a></p>)}<div class="tool-pills">{item.projets_cles?.map((p:string)=><a class="chip" href={route(lang,'projects',p)}>{p.replaceAll('-',' ')}</a>)}</div></div></details>)}
</div></section>
