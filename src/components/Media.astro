---
import {route,tools,toolId,type Block,type Lang} from '../lib/content';
const {blocks=[],lang='fr'}=Astro.props as {blocks:Block[],lang:Lang};
const gallery=(media:any)=>media.type==='avant-apres'?[media.before,media.after].filter(Boolean):media.items;
const toolFor=(name:string)=>tools.outils.find(t=>t.id===toolId(name));
---
{blocks.map(block=>block.type==='text'?<div class="prose" set:html={block.html}/>:<div class="media-block">
  {block.media.type==='icones-outils'?<div class="tool-pills">{block.media.items.map(item=>{const tool=toolFor(item.src);return tool?<a class="chip tool-chip" href={route(lang,'about')+'#outil-'+tool.id}><img src={tool.icone} alt="" width="16" height="16" loading="lazy"/>{tool.nom}</a>:<span class="chip tool-chip">{item.src.replace(/^\//,'').replace(/\s*\([^)]*à fournir[^)]*\)/,'')}</span>;})}</div>:
  <div class="carousel" aria-roledescription={lang==='fr'?'carrousel':'carousel'}>
    <div class="slides" tabindex="0" aria-label={lang==='fr'?'Images du projet — faites défiler':'Project images — scroll to browse'}>{gallery(block.media).map((item:any)=><figure><button class="zoom" data-lightbox={item.src} aria-label={item.caption|| (lang==='fr'?'Agrandir l’image':'Enlarge image')}><img src={item.src.replace('.webp','-640.webp')} alt={item.caption} loading="lazy" decoding="async" width="640" height="360" draggable="false"/></button><figcaption>{item.caption}</figcaption></figure>)}</div>
    {gallery(block.media).length>1&&<div class="carousel-controls"><button data-prev aria-label={lang==='fr'?'Précédent':'Previous'}>←</button><button data-next aria-label={lang==='fr'?'Suivant':'Next'}>→</button></div>}
  </div>}
</div>)}
