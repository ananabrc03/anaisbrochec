---
import {texts,route,type Lang} from '../lib/content';
const {lang} = Astro.props as {lang:Lang};const t=texts(lang);
---
<section class="shell section"><p class="eyebrow">{t.nav.contact}</p><h1>{t.contact.title}<span class="coral">.</span></h1><p class="lead">{t.contact.intro}</p><div class="contact-grid"><aside class="contact-info"><span class="contact-mark" aria-hidden="true">↗</span><h3>{t.contact.location}</h3><p>{t.contact.location_sub}</p><hr/><p>{t.contact.email_label}<br/><a href={'mailto:'+t.coordonnees.email}>{t.coordonnees.email}</a></p><button class="copy chip" data-copy={t.coordonnees.email} data-copied={t.common.copied}>{t.common.copy}</button><p>{t.contact.phone_label}<br/><a href={t.coordonnees.telephone_href}>{t.coordonnees.telephone}</a></p><a href={t.coordonnees.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></aside>
<form id="contact-form" class="form-card" novalidate data-error={t.contact.error} data-success={t.contact.success} data-sending={t.contact.sending} data-submit={t.contact.submit} data-required={t.contact.err_required} data-email={t.contact.err_email} data-file-type={t.contact.err_file_type} data-file-size={t.contact.err_file_size}><h2>{t.contact.form_title}</h2><input type="hidden" name="langue" value={lang}/><div class="form-grid">{[['nom',t.contact.f_lastname],['prenom',t.contact.f_firstname],['email',t.contact.f_email],['entreprise',t.contact.f_company]].map(([name,title])=><label>{title}<input name={name} type={name==='email'?'email':'text'} maxlength={name==='email'?200:name==='entreprise'?150:100} required={name!=='entreprise'} autocomplete={name==='nom'?'family-name':name==='prenom'?'given-name':name==='email'?'email':'organization'} aria-describedby={'error-'+name}/><span class="field-error" id={'error-'+name}/></label>)}</div><label>{t.contact.f_type}<select name="type_demande" required aria-describedby="error-type_demande"><option value="">{t.contact.f_type_placeholder}</option>{Object.entries(t.contact.types).map(([key,val])=><option value={key}>{val}</option>)}</select><span class="field-error" id="error-type_demande"/></label><label>{t.contact.f_message}<textarea name="message" rows="6" required minlength="10" maxlength="5000" aria-describedby="error-message"/><span class="counter">0 / 5000</span><span class="field-error" id="error-message"/></label><label class="file-label">{t.contact.f_file}<input type="file" name="fichier" accept="application/pdf,.pdf" aria-describedby="error-fichier"/><span class="file-info"/><span class="field-error" id="error-fichier"/></label><button type="button" class="remove-file chip" hidden>{t.common.close} ×</button><label class="consent"><input name="consentement" type="checkbox" value="true" required aria-describedby="error-consentement"/><span>{t.contact.f_consent} <a href={route(lang,'privacy')}>{t.footer.privacy}</a></span></label><span class="field-error" id="error-consentement"/><div class="form-status" role="status" aria-live="polite"/><button class="button primary" type="submit">{t.contact.submit}<span>↗</span></button></form></div></section>
<script>import '../scripts/contact';</script>
