---
import {route,texts,codeLabel,type Lang} from '../lib/content';
const {project:p,lang}=Astro.props as {project:any,lang:Lang};
---
<article class="project-card" data-domains={p.domaines.join(' ')}>
  <a class="card-main" href={route(lang,'projects',p.id)}>
    <div class="card-copy">
      <p class="eyebrow">{texts(lang).project.label} {String(p.ordre).padStart(2,'0')} · {texts(lang).projects.domains[p.domaines[0] as 'produit']}</p>
      <h3>{p.titre}<span aria-hidden="true">↗</span></h3>
      <p>{p.intitule}</p>
      <p class="muted small">{p.periode.affichage}</p>
    </div>
  </a>
  <div class="card-chips">{p.familles_cles.map((c:string)=><a class="chip" href={route(lang,'about')+'#'+c}>{codeLabel(c,lang)}</a>)}</div>
</article>
