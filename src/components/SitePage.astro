---
import Accueil from '../vues/Accueil.astro';
import Projets from '../vues/Projets.astro';
import APropos from '../vues/APropos.astro';
import CV from '../vues/CV.astro';
import Contact from '../vues/Contact.astro';
import Projet from '../vues/Projet.astro';
import Mentions from '../vues/Mentions.astro';
const {page,...props}=Astro.props;
const views={home:Accueil,projects:Projets,about:APropos,cv:CV,contact:Contact,project:Projet,legal:Mentions,privacy:Mentions};
const Page=views[page as keyof typeof views];
---
<Page {...props} page={page}/>
